# =============================================================================
# Dotfiles .gitignore - Whitelist Strategy
# =============================================================================
# Strategy: Ignore everything by default, then explicitly whitelist what we want
# This prevents accidentally committing system-generated files from stowed configs
# =============================================================================

# -----------------------------------------------------------------------------
# IGNORE EVERYTHING IN KEY DIRECTORIES
# -----------------------------------------------------------------------------

# Ignore everything in config directory
config/.config/*

# Ignore everything in .local (if stowed)
.local/*

# -----------------------------------------------------------------------------
# WHITELIST: All User Configs (except system-generated)
# -----------------------------------------------------------------------------
# We whitelist everything by default, then re-ignore system dirs below
!config/.config/*/
!config/.config/**

# But immediately re-ignore known system-generated directories
config/.config/Claude/
config/.config/Code/
config/.config/VSCodium/
config/.config/Cursor/
config/.config/google-chrome/
config/.config/google-chrome-for-testing/
config/.config/chromium/
config/.config/BraveSoftware/
config/.config/firefox/
config/.config/docker/
config/.config/Docker Desktop/
config/.config/Kiro/
config/.config/dconf/
config/.config/pulse/
config/.config/gtk-3.0/
config/.config/gtk-4.0/
config/.config/ibus/
config/.config/nautilus/
config/.config/tiling-assistant/
config/.config/evolution/
config/.config/fish/
config/.config/menus/
config/.config/uv/
config/.config/org.gnome.*/
config/.config/QtProject.conf
config/.config/mimeapps.list
config/.config/user-dirs.*
config/.config/.gsd-keyboard.settings-ported
config/.config/GNOME-xdg-terminals.list
config/.config/gnome-initial-setup-done
config/.config/monitors.xml
config/.config/ubuntu-xdg-terminals.list
config/.config/xdg-terminals.list

# Re-ignore generated / app-state config dirs (added 2026-06-29)
config/.config/enchant/
config/.config/eog/
config/.config/falkon/
config/.config/gh/
config/.config/gnome-initial-setup/
config/.config/libreoffice/
config/.config/liv-ai-scripts/
config/.config/systemd/
config/.config/ubuntu-insights/
config/.config/vlc/

# Re-ignore Neovim generated files
config/.config/nvim/lazy-lock.json
config/.config/nvim/.luarc.json
config/.config/nvim/.stylua.toml
config/.config/nvim/plugin/
config/.config/nvim/.git/

# -----------------------------------------------------------------------------
# WHITELIST: Root Configuration Files
# -----------------------------------------------------------------------------
# Scripts directory (whitelist everything)
!scripts/
!scripts/**

# Zsh configuration
!zsh/
!zsh/**

# Tmux configuration
!tmux/
!tmux/**

# Core dotfiles
!.zshrc
!.zshenv
!.zprofile
!.tmux.conf
!.gitconfig
!.gitignore
!.gitignore_global

# Installation scripts
!install.sh
!bootstrap.sh
!migrate_to_lazyvim.sh
!Makefile

# Documentation
!README.md
!*.md
!CONTRIBUTING.md
!QUICKSTART.md
!INSTALL_GUIDE.md
!CHANGELOG.md
!LICENSE

# -----------------------------------------------------------------------------
# ALWAYS IGNORE: System & Generated Files
# -----------------------------------------------------------------------------

# Installation tracking (runtime only)
.install.log
.install.log.*
.install_status

# Environment files with secrets
*.local

# Root-level claude/ runtime dir (NOT the tracked .claude/ project config)
/claude/

# Backups
backups/
*.backup
*.bak
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
.directory
.Trash-*/

# Vim/Neovim swap files
*.swp
*.swo
*.swn
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

# IDE/Editor
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.temp
*.log
*.pid

# Node modules (if any dev tools use them)
node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/

# Serena MCP tool per-project artifacts
.serena/

# -----------------------------------------------------------------------------
# NOTE: System-Generated Config Directories
# -----------------------------------------------------------------------------
# The following are already ignored via the whitelist section above:
#   - Browsers: Chrome, Firefox, Brave, Chromium
#   - IDEs: Code, Claude, Cursor, VSCodium
#   - Desktop: dconf, pulse, gtk, ibus, nautilus, tiling-assistant
#   - Other: Kiro, QtProject.conf, mimeapps.list
#
# To add a new system-generated app to ignore, add it to the whitelist section

# -----------------------------------------------------------------------------
# NOTES
# -----------------------------------------------------------------------------
# To check what's being tracked: git ls-files
# To check what's being ignored: git status --ignored
# To stop tracking a file: git rm --cached <file>

# Machine-local zsh overrides (work paths, secrets)
.zshrc.local
