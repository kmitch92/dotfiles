# =============================================================================
# Dotfiles .gitignore - Selective tracking strategy
# =============================================================================

# -----------------------------------------------------------------------------
# Claude working files (ignore everything, then selectively include)
# -----------------------------------------------------------------------------
claude/.claude/*

# Keep these specific files/directories
!claude/.claude/CLAUDE.md
!claude/.claude/settings.json
!claude/.claude/agents/
!claude/.claude/agents/**
!claude/.claude/plugins/
!claude/.claude/plugins/**

# Explicitly ignore working files even if parent is included
claude/.claude/debug/
claude/.claude/history.jsonl
claude/.claude/shell-snapshots/
claude/.claude/statsig/
claude/.claude/todos/

# -----------------------------------------------------------------------------
# Config working files (if any specific ignores needed)
# -----------------------------------------------------------------------------
# Add specific ignores here if config/ generates working files
config/.config/nvim/lazy-lock.json  # Example: lock file you don't want
config/.config/Kiro/
config/.config/google-chrome/
config/.config/google-chrome-for-testing/
# -----------------------------------------------------------------------------
# System-specific configs (shouldn't be in dotfiles)
# -----------------------------------------------------------------------------
# GNOME/Linux desktop configs
*/.config/dconf/
*/.config/pulse/
*/.config/org.gnome.Ptyxis/
*/.config/tiling-assistant/

# Backup configs (shouldn't be tracked)
*/.config/nvim.backup.*/

# -----------------------------------------------------------------------------
# Backup directories
# -----------------------------------------------------------------------------
backups/

# -----------------------------------------------------------------------------
# System files
# -----------------------------------------------------------------------------
.DS_Store
*.swp
*.swo
*~
