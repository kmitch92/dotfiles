# Ghostty Terminal Configuration
# https://ghostty.org/docs/config

# Font Configuration
font-family = "JetBrains Mono"
font-size = 13
font-feature = -calt  # Disable ligatures, remove if you want them

# Window Settings
window-padding-x = 10
window-padding-y = 10
window-decoration = true
background-opacity = 0.95
background-blur-radius = 20

# Theme: Catppuccin Mocha
# Feel free to change to another theme
background = #1e1e2e
foreground = #cdd6f4
cursor-color = #f5e0dc
selection-background = #585b70
selection-foreground = #cdd6f4

# Colors (Catppuccin Mocha)
palette = 0=#45475a
palette = 1=#f38ba8
palette = 2=#a6e3a1
palette = 3=#f9e2af
palette = 4=#89b4fa
palette = 5=#f5c2e7
palette = 6=#94e2d5
palette = 7=#bac2de
palette = 8=#585b70
palette = 9=#f38ba8
palette = 10=#a6e3a1
palette = 11=#f9e2af
palette = 12=#89b4fa
palette = 13=#f5c2e7
palette = 14=#94e2d5
palette = 15=#a6adc8

# Scrollback
scrollback-limit = 10000

# Shell
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Cursor
cursor-style = block
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true

# macOS specific
macos-option-as-alt = true
macos-titlebar-style = tabs
