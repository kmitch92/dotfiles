# Ghostty Terminal Configuration
# https://ghostty.org/docs/config

# Font Configuration
font-family = "JetBrains Mono"
font-size = 13
font-feature = -calt  # Disable ligatures, remove if you want them

# Window Settings
window-padding-x = 10
window-padding-y = 10
window-decoration = true
background-opacity = 0.95
background-blur-radius = 20

# Theme: Gruvbox Dark Hard
# Feel free to change to another theme
background = #1d2021
foreground = #ebdbb2
cursor-color = #ebdbb2
selection-background = #504945
selection-foreground = #ebdbb2

# Colors (Gruvbox Dark Hard)
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2

# Scrollback
scrollback-limit = 10000

# Shell
shell-integration = detect
shell-integration-features = cursor,sudo,title

# Cursor
cursor-style = block
cursor-style-blink = true

# Mouse
mouse-hide-while-typing = true
clipboard-trim-trailing-spaces = true

# macOS specific
macos-option-as-alt = true
macos-titlebar-style = tabs
