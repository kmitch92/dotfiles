at are not written in lowercase"},"docker.languageserver.diagnostics.instructionCasing":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for instructions that are not written in uppercase"},"docker.languageserver.diagnostics.instructionCmdMultiple":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for flagging a Dockerfile with multiple CMD instructions"},"docker.languageserver.diagnostics.instructionEntrypointMultiple":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for flagging a Dockerfile with multiple ENTRYPOINT instructions"},"docker.languageserver.diagnostics.instructionHealthcheckMultiple":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for flagging a Dockerfile with multiple HEALTHCHECK instructions"},"docker.languageserver.diagnostics.instructionJSONInSingleQuotes":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for JSON instructions that are written incorrectly with single quotes"},"docker.languageserver.diagnostics.instructionWorkdirRelative":{"scope":"resource","type":"string","default":"warning","enum":["ignore","warning","error"],"description":"Controls the diagnostic severity for WORKDIR instructions that do not point to an absolute path"},"docker.languageserver.formatter.ignoreMultilineInstructions":{"scope":"resource","type":"boolean","default":false,"description":"Controls whether the Dockerfile formatter should ignore instructions that span multiple lines when formatting"},"containers.composeBuild":{"type":"boolean","default":true,"description":"Set to true to include --build option when compose command is invoked"},"containers.composeDetached":{"type":"boolean","default":true,"description":"Set to true to include --d (detached) option when compose command is invoked"},"containers.showRemoteWorkspaceWarning":{"type":"boolean","default":true,"description":"Set to true to prompt to switch from \"UI\" extension mode to \"Workspace\" extension mode if an operation is not supported in UI mode."},"containers.scaffolding.templatePath":{"type":"string","description":"The path to use for scaffolding templates."},"containers.containerCommand":{"type":"string","description":"Command to use for container actions (e.g. `docker` command). If the executable path contains whitespace, it needs to be quoted appropriately. If unset, the extension will attempt to auto-detect the command to use.","scope":"machine-overridable"},"containers.composeCommand":{"type":"string","description":"Command to use for compose actions (e.g. `docker-compose`, `docker compose`, etc. command). If the executable path contains whitespace, it needs to be quoted appropriately. If unset, the extension will attempt to auto-detect the command to use.","scope":"machine-overridable"},"containers.enableComposeLanguageService":{"type":"boolean","default":true,"description":"Whether or not to enable the Compose Language Service. Changing requires a restart to take effect."},"containers.containerClient":{"type":"string","description":"Which container client to use. If not specified, Docker will be used. Changing requires a restart to take effect.","scope":"machine-overridable","enum":["","com.microsoft.visualstudio.containers.docker","com.microsoft.visualstudio.containers.podman"],"enumItemLabels":["Default","Docker","Podman"]},"containers.orchestratorClient":{"type":"string","description":"Which container orchestrator client to use. If not specified, Docker Compose will be used. Changing requires a restart to take effect.","scope":"machine-overridable","enum":["","com.microsoft.visualstudio.orchestrators.dockercompose","com.microsoft.visualstudio.orchestrators.podmancompose"],"enumItemLabels":["Default","Docker Compose","Podman Compose"]}}},"commands":[{"command":"vscode-containers.compose.down","title":"Compose Down","category":"Containers"},{"command":"vscode-containers.compose.restart","title":"Compose Restart","category":"Containers"},{"command":"vscode-containers.compose.up","title":"Compose Up","category":"Containers"},{"command":"vscode-containers.compose.up.subset","title":"Compose Up - Select Services","category":"Containers"},{"command":"vscode-containers.compose.down.subset","title":"Compose Down - Select Services","category":"Containers"},{"command":"vscode-containers.configure","title":"Add Docker Files to Workspace...","category":"Containers"},{"command":"vscode-containers.configureCompose","title":"Add Compose Files to Workspace...","category":"Containers"},{"command":"vscode-containers.openDockerDownloadPage","title":"Learn More About Installing Docker Desktop","category":"Containers"},{"command":"vscode-containers.containers.attachShell","title":"Attach Shell","category":"Containers"},{"command":"vscode-containers.containers.browse","title":"Open in Browser","category":"Containers"},{"command":"vscode-containers.containers.configureExplorer","title":"Configure Explorer...","category":"Containers","icon":"$(settings-gear)"},{"command":"vscode-containers.containers.downloadFile","title":"Download...","category":"Containers","icon":"$(desktop-download)"},{"command":"vscode-containers.containers.inspect","title":"Inspect","category":"Containers"},{"command":"vscode-containers.containers.openFile","title":"Open","category":"Containers","icon":"$(go-to-file)"},{"command":"vscode-containers.containers.prune","title":"Prune...","category":"Containers","icon":"$(clear-all)"},{"command":"vscode-containers.containers.refresh","title":"Refresh","category":"Containers","icon":"$(refresh)"},{"command":"vscode-containers.containers.remove","title":"Remove...","categor